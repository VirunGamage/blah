18,#51068,#53118,#32668,#34718,#36768,#38818,#40868,#42918,#44968,#47018,#49068,#51118,#53168,#32718,#34768,#36818,#38868,#40918,#42968,#45018,#47068,#49118,#51168,#53218,#32768,#34818,#36868,#38918,#40968,#43018,#45068,#47118,#49168,#51218,#53268,#32818,#34868,#36918,#38968,#41018,#43068,#45118,#47168,#49218,#51268,#53318,#32868,#34918,#36968,#39018,#41068,#43118,#45168,#47218,#49268,#51318,#53368,#32918,#34968,#37018,#39068,#41118,#43168,#45218,#47268,#49318,#51368,#53418,#32968,#35018,#37068,#39118,#41168,#43218,#45268,#47318,#49368,#51418,#53468,#33018,#35068,#37118,#39168,#41218,#43268,#45318,#47368,#49418,#51468,#53518,#33068,#35118,#37168,#39218,#41268,#43318,#45368,#47418,#49468,#51518,#53568,#33118,#35168,#37218,#39268,#41318,#43368,#45418,#47468,#49518,#51568,#53618,#33168,#35218,#37268,#39318,#41368,#43418,#45468,#47518,#49568,#51618,#53668,#33218,#35268,#37318,#39368,#41418,#43468,#45518,#47568,#49618,#51668,#53718,#33268,#35318,#37368,#39418,#41468,#43518,#45568,#47618,#49668,#51718,#53768,#33318,#35368,#37418,#39468,#41518,#43568,#45618,#47668,#49718,#51768,#53818,#33368,#35418,#37468,#39518,#41568,#43618,#45668,#47718,#49768,#51818,#53868),#145);
#61894=IFCRELASSOCIATESMATERIAL('2w9l1Lg9r69vuxZv5xYUCS',$,$,$,(#54301,#54369,#54233),#153);
#61895=IFCPROPERTYSET('3u1rPLTMH1Ax9aIgJofJew',$,'Pset_ModelNotes',$,(#61897,#61898,#61899,#61900,#61901,#61902,#61903,#61904,#61905,#61906,#61907,#61908,#61909,#61910,#61911,#61912,#61913,#61914));
#61896=IFCRELDEFINESBYPROPERTIES('2FxM_05qL9SfH85KftVzws',$,$,$,(#15),#61895);
#61897=IFCPROPERTYSINGLEVALUE('Source',$,IFCLABEL('Concept_Desg2 (1).dwg + CAD explanation for 3d model.docx'),$);
#61898=IFCPROPERTYSINGLEVALUE('Origin',$,IFCLABEL('Grid A1 of GROUND LEVEL PARKING PLAN = DWG (56.30, 28.12). +X east along frontage, +Y north.'),$);
#61899=IFCPROPERTYSINGLEVALUE('Units',$,IFCLABEL('metres'),$);
#61900=IFCPROPERTYSINGLEVALUE('Note01',$,IFCLABEL('Walls are drawn in the DWG as double lines 100 mm apart; they are modelled on the drawn centre-line as 200 mm blockwork (glazed shopfront/foyer lines as 100 mm glazing). Curtain walls: the atrium box (x 64-74 m, in front of the frontage, up to +22.0 m per the front elevation) and the first/second-floor front facade (x 0-48 m, hatched glazing band in the front elevation).'),$);
#61901=IFCPROPERTYSINGLEVALUE('Note02',$,IFCLABEL('A stray single line at x = 24 m inside theatre 1 (left over from the first-floor plan) is ignored because it would cut through the seat rows.'),$);
#61902=IFCPROPERTYSINGLEVALUE('Note03',$,IFCLABEL('Columns: 600 x 600 mm RC, taken from the "Columns" layer squares of each plan, full storey height.'),$);
#61903=IFCPROPERTYSINGLEVALUE('Note04',$,IFCLABEL('Ramp: the yellow "ramp" layer is the east turn of the parking loop - a 6.0 m wide, two-lane (2 x 3.0 m) J-shaped ramp, inner radius 3.0 m, outer radius 9.0 m, centre-line 25.97 m (as labelled). It starts at the "UP" end (x 57.5-63.4, y 14.0), runs north, turns 90 degrees anticlockwise and ends at the "DOWN" end (x 47.7, y 26.75-32.75), rising one storey (3.2 m): slope 3.2/25.97 = 12.3 % (1:8.1), within the usual 1:8 car-park ramp limit. The same ramp is stacked GF->P1 and P1->P2 so that, together with the flat loop aisle on each deck, cars drive a continuous spiral up/down the parking levels. 1.0 m kerb walls run along both ramp edges; the P1 and P2 slabs are opened over the ramp footprint.'),$);
#61904=IFCPROPERTYSINGLEVALUE('Note05',$,IFCLABEL('Edge protection: 1.1 m upstands line the ramp opening in the first and second parking decks (the second deck is closed at the lower ramp end, where its bottom lane would otherwise run into the opening).'),$);
#61905=IFCPROPERTYSINGLEVALUE('Note06',$,IFCLABEL('Vehicle circulation: the green elongated loop (two 3.0 m lanes, curved west end, ramp at the east end) is modelled as a 20 mm drive-aisle surface on every parking deck; the ground floor also has the two-way entrance spine and the two curved driveways to the A2 road.'),$);
#61906=IFCPROPERTYSINGLEVALUE('Note07',$,IFCLABEL('Parking stalls are taken from the 22 (ground) and 18 (first/second) "3car bay" blocks: 66 stalls on the ground level (the drawing note says 63 - the DWG geometry is kept as drawn), 54 on each of the first and second parking levels.'),$);
#61907=IFCPROPERTYSINGLEVALUE('Note08',$,IFCLABEL('Lifts: two banks of 3 lift cars (crossed rectangles; not columns) - bank A at the north side (x 47.95-55.65, y 22.8-25.6), bank B at the east side (x 64.3-67.1, y 0.3-8.35). Shafts are continuous from ground to +28.5 m (1.5 m overrun), 200 mm walls, car 2.3-2.4 m x 2.4 m, 1.1 m landing door to every floor.'),$);
#61908=IFCPROPERTYSINGLEVALUE('Note09',$,IFCLABEL('Staircase: dog-leg stair in the 6.25 x 5.0 m enclosure at the west end (same position on every floor), two 1.7 m flights either side of a 1.4 m central spine wall, half landing on the west side, 1.8 m double doors to each floor. 3.2 m storeys: 18 risers of 178 mm, 280 mm goings (as drawn: 8 treads per flight); 4.2 m storeys: 24 risers of 175 mm, 280 mm goings (11 treads per flight, as drawn). The stair serves ground to third floor.'),$);
#61909=IFCPROPERTYSINGLEVALUE('Note10',$,IFCLABEL('Escalators: pairs (one up, one down) at 30 degrees. East pair: 8 m units ground->P1->P2->first floor and 9.7 m units first->second->third floor (lower end at the north/"UP" end). Central pair: 9.6 m units first->second->third floor (lower end at the east/"UP" end). Slab voids as drawn on the "void" layer, with 1.1 m glass balustrades.'),$);
#61910=IFCPROPERTYSINGLEVALUE('Note11',$,IFCLABEL('Slabs: 200 mm RC (250 mm ground slab extended over the 80 x 50 m plot as external paving). The parking decks are 74 x 34 m (with the east wing), the upper floors 74 x 26 m (as drawn). The rear strip of the second parking deck (y 26-34 m) is covered by a podium roof slab at first-floor level, the single-storey STP/chiller annex has its own roof, the glazed atrium box (x 64-74, y -8-0) is open from ground to its roof at +22.0 m.'),$);
#61911=IFCPROPERTYSINGLEVALUE('Note12',$,IFCLABEL('The trapezoidal outline in front of the first/second parking plan (projecting 5.5 m, divided at x = 32/40/48/56 m) is modelled as a projecting planter slab with 1.1 m parapets on both parking decks.'),$);
#61912=IFCPROPERTYSINGLEVALUE('Note13',$,IFCLABEL('Cinema (third floor, 9.0 m storey): theatre 1 (upper-left, 12 rows x 9 = 108 seats) and theatre 2 (upper-middle, 13 rows, 200 seats) face curved screens on their WEST walls; theatre 3 (lower-right, 7 rows, 136 seats) faces a curved screen on its SOUTH wall - all taken from the magenta seat blocks and screen arcs in the DWG. Stadium seating rises 350 mm per row (back rows of T1/T2 at +3.85/+4.2 m, leaving > 4.5 m headroom). Screens: 6.0 m (T1) and 8.5 m (T2, T3) wide, bottom edge 1.2 m above the floor.'),$);
#61913=IFCPROPERTYSINGLEVALUE('ParkingStalls',$,IFCLABEL('L00=66, L01=54, L02=54'),$);
#61914=IFCPROPERTYSINGLEVALUE('Theatres',$,IFCLABEL('Theatre 1 (108 seats): 12 rows, 108 seats, screen side west; Theatre 2 (200 seats): 13 rows, 200 seats, screen side west; Theatre 3 (136 seats): 7 rows, 136 seats, screen side south'),$);
ENDSEC;
END-ISO-10303-21;
